# This repository publishes only the A26 shell, its helper scripts, and the
# curated design notes. The surrounding device-research workspace is private.
/*
!/.gitignore
!/LICENSE
!/README.md
!/TODO.md
!/src/
!/scripts/
!/notes/
!/docs/

/src/*
!/src/a26-shell/
!/src/a26-audio-bridge/
!/src/moon-audiod/
!/src/moon-telephonyd/
!/src/moon-gpu/
!/src/moon-wl-demo/
/src/moon-wl-demo/target/
!/src/oss-rebootmode-clear/
!/src/venus/
/src/a26-shell/target/
/src/moon-telephonyd/target/

/scripts/*
!/scripts/a26-shell/
!/scripts/device/
!/scripts/direct-boot/
!/scripts/kernel/
!/scripts/native-init/
!/scripts/gpu/
!/scripts/venus/
!/scripts/wayland/
/scripts/device/*
!/scripts/device/90-moon-autostart.sh
!/scripts/device/moon-boot-supervisor.sh
!/scripts/device/moon-direct-policy.sh
!/scripts/device/moon-post-ready.sh
!/scripts/device/moon-boot-confirm.sh
!/scripts/device/moon-mode-stop.list
!/scripts/device/moon-audio-start.sh
!/scripts/device/moon-audio-stop.sh
!/scripts/device/moon-audio-keeper.sh
!/scripts/device/moon-gpu-session.sh
!/scripts/device/moon-suspend-cycle.sh
!/scripts/device/moon-telephony-start.sh
!/scripts/device/moon-telephony-stop.sh
!/scripts/device/a26-enter-chroot.sh
!/scripts/device/a26-xorg-takeover.sh
!/scripts/device/a26-xorg-safety-watchdog.sh
!/scripts/device/a26-android-graphics-restore.sh
!/scripts/device/a26-xorg-persistent-session.sh
/scripts/a26-shell/__pycache__/
/scripts/kernel/__pycache__/

/notes/*
!/notes/a26-shell/
!/notes/direct-boot/
!/notes/stage2/
!/notes/ui-polish/
!/notes/telephony/
!/notes/gpu/
!/notes/wayland/
/notes/a26-shell/*
!/notes/a26-shell/README.md
!/notes/a26-shell/APPLE-KEYBOARD-LAYOUT.md
!/notes/a26-shell/X11-INPUT-DEADLOCK.md
!/notes/a26-shell/launcher-redesign.png
!/notes/a26-shell/system-view.png
!/notes/a26-shell/ui-redesign-verification.txt

# Generated locally by the build/install/test workflow.
/build/
/images/
*.log
*.ppm
*.tmp
